::CLASS Person
::METHOD INIT
  EXPOSE firstName familyName salary
  USE ARG firstName, familyName, salary
  self~init:super
::METHOD UNINIT
  EXPOSE firstName familyName
  SAY "Object: <"firstName familyName"> is about to be destroyed."
